#!/bin/bash
set -euo pipefail

until ip -o -4 addr show | grep -q ' ${private_ip}/'; do
  sleep 2
done

priv_if="$(ip -o -4 addr show | awk '/${private_ip}\//{print $2; exit}')"

cat >/usr/local/sbin/k3s-lab-default-route <<'SCRIPT'
#!/bin/bash
set -euo pipefail
ip route replace default via ${gateway}
SCRIPT
chmod 0755 /usr/local/sbin/k3s-lab-default-route
/usr/local/sbin/k3s-lab-default-route

mkdir -p /etc/systemd/resolved.conf.d
cat >/etc/systemd/resolved.conf.d/k3s-lab.conf <<'EOF'
[Resolve]
DNS=8.8.8.8 1.1.1.1
FallbackDNS=185.12.64.1 185.12.64.2
EOF
resolvectl dns "$priv_if" 8.8.8.8 1.1.1.1 || true
systemctl restart systemd-resolved || true

cat >/etc/systemd/system/k3s-lab-default-route.service <<'UNIT'
[Unit]
Description=Default route via Hetzner network gateway (NAT on K3s server)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/k3s-lab-default-route

[Install]
WantedBy=multi-user.target
UNIT
systemctl daemon-reload
systemctl enable --now k3s-lab-default-route.service

until curl -kfsS '${server_url}/ping' >/dev/null; do
  sleep 5
done

until curl -sfL https://get.k3s.io -o /tmp/install-k3s.sh; do
  sleep 5
done
chmod 0755 /tmp/install-k3s.sh
K3S_URL='${server_url}' \
K3S_TOKEN='${token}' \
INSTALL_K3S_EXEC='agent --node-name ${node_name} --node-ip ${private_ip} --flannel-iface '"$priv_if" \
  /tmp/install-k3s.sh
